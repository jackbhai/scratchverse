{
  "name": "scratchverse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/gen-manifest.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "assets": "python3 scripts/synth-textures.py && python3 scripts/process_assets.py && node scripts/copy-fonts.mjs",
    "tune": "node scripts/tune.mjs",
    "test": "bash scripts/run-tests.sh",
    "lint": "eslint src scripts --ext .js,.jsx,.mjs",
    "preview:static": "node scripts/preview-render.mjs",
    "shots": "bash scripts/ensure-browser-libs.sh && node scripts/shots.mjs",
    "contact": "python3 scripts/contact-sheet.py",
    "fonts": "node scripts/copy-fonts.mjs",
    "hero": "python3 scripts/hero.py"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-color-emoji": "^5.3.1",
    "@fontsource/sora": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.56.0",
    "vite": "^5.4.8"
  }
}