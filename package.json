{
  "name": "scratchverse",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/gen-manifest.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "fonts": "node scripts/copy-fonts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src scripts tests",
    "fmt": "biome format --write src scripts tests",
    "test": "vitest run && bash scripts/run-tests.sh",
    "test:unit": "vitest run",
    "test:integration": "bash scripts/run-tests.sh",
    "tune": "node scripts/tune.mjs",
    "shots": "bash scripts/ensure-browser-libs.sh && node scripts/shots.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run tune -- --check && npm run build",
    "contact": "python3 scripts/contact-sheet.py"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "immer": "^10.1.1",
    "motion": "^12.23.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@fontsource/manrope": "^5.2.5",
    "@fontsource/sora": "^5.2.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
